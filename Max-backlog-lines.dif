diff -ruN orig/quassel-master/src/core/sqlitestorage.cpp quassel-master/src/core/sqlitestorage.cpp
--- orig/quassel-master/src/core/sqlitestorage.cpp	2026-09-20 22:12:13.000000000 +0000
+++ quassel-master/src/core/sqlitestorage.cpp	2026-09-28 13:45:25.627887374 +0000
