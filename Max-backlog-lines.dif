diff -ruN orig/quassel-master/src/core/core.cpp quassel-master/src/core/core.cpp
--- orig/quassel-master/src/core/core.cpp	2026-09-20 22:12:13.000000000 +0000
+++ quassel-master/src/core/core.cpp	2026-09-28 13:45:25.628341560 +0000
@@ -478,8 +478,18 @@
 
 void Core::syncStorage()
 {
-    if (_storage)
-        _storage->sync();
+    if (!_storage)
+        return;
+
+    _storage->sync();
+
+    // Enforce the optional per-buffer backlog limit (--max-backlog-lines)
+    int maxLines = Quassel::optionValue("max-backlog-lines").toInt();
+    if (maxLines > 0) {
+        int deleted = _storage->trimBacklog(maxLines);
+        if (deleted > 0)
+            qInfo() << "Backlog limit: removed" << deleted << "old messages (keeping" << maxLines << "per buffer)";
+    }
 }
 
 /*** Storage Access ***/
diff -ruN orig/quassel-master/src/core/postgresqlstorage.cpp quassel-master/src/core/postgresqlstorage.cpp
--- orig/quassel-master/src/core/postgresqlstorage.cpp	2026-09-20 22:12:13.000000000 +0000
+++ quassel-master/src/core/postgresqlstorage.cpp	2026-09-28 13:45:25.628196366 +0000
@@ -1290,6 +1290,51 @@
     }
 }
 
+int PostgreSqlStorage::trimBacklog(int keepPerBuffer)
+{
+    if (keepPerBuffer <= 0)
+        return 0;
+
+    QSqlDatabase db = logDb();
+    std::vector<int> bufferIds;
+
+    if (!beginReadOnlyTransaction(db)) {
+        qWarning() << "PostgreSqlStorage::trimBacklog(): cannot start read only transaction!";
+        return 0;
+    }
+    {
+        QSqlQuery query(db);
+        query.prepare(queryString("select_all_bufferids"));
+        safeExec(query);
+        watchQuery(query);
+        while (query.next()) {
+            bufferIds.push_back(query.value(0).toInt());
+        }
+    }
+    db.commit();
+
+    int deleted = 0;
+    for (int bufferId : bufferIds) {
+        if (!beginTransaction(db)) {
+            qWarning() << "PostgreSqlStorage::trimBacklog(): cannot start transaction!";
+            break;
+        }
+        QSqlQuery query(db);
+        query.prepare(queryString("delete_backlog_trim"));
+        query.bindValue(":bufferid", bufferId);
+        query.bindValue(":offset", keepPerBuffer - 1);
+        safeExec(query);
+        if (!watchQuery(query)) {
+            db.rollback();
+            continue;
+        }
+        if (query.numRowsAffected() > 0)
+            deleted += query.numRowsAffected();
+        db.commit();
+    }
+    return deleted;
+}
+
 bool PostgreSqlStorage::renameBuffer(const UserId& user, const BufferId& bufferId, const QString& newName)
 {
     QSqlDatabase db = logDb();
