diff -ruN orig/quassel-master/src/core/SQL/PostgreSQL/delete_backlog_trim.sql quassel-master/src/core/SQL/PostgreSQL/delete_backlog_trim.sql
--- orig/quassel-master/src/core/SQL/PostgreSQL/delete_backlog_trim.sql	1970-01-01 00:00:00.000000000 +0000
+++ quassel-master/src/core/SQL/PostgreSQL/delete_backlog_trim.sql	2026-09-28 13:45:25.582692241 +0000
@@ -0,0 +1,3 @@
+DELETE FROM backlog
+WHERE bufferid = :bufferid
+AND messageid < (SELECT messageid FROM backlog WHERE bufferid = :bufferid ORDER BY messageid DESC LIMIT 1 OFFSET :offset)
